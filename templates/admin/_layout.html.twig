<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — WRA602</title>
    {% block stylesheets %}
        {{ importmap('app') }}
        <style>
            body { font-family: system-ui, sans-serif; margin: 0; background: #f4f6fa; color: #1f2937; }
            header { background: #2b6cb0; color: white; padding: 12px 24px; }
            header nav { display: flex; gap: 18px; align-items: center; }
            header nav a { color: white; text-decoration: none; font-weight: 500; }
            header nav a:hover { text-decoration: underline; }
            header .spacer { flex: 1; }
            main { padding: 24px; max-width: 1200px; margin: 0 auto; }
            .flash { padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; }
            .flash-success { background: #d1fae5; color: #065f46; }
            .flash-error { background: #fee2e2; color: #991b1b; }
            .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
            .kpi { background: white; padding: 16px; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
            .kpi strong { display: block; font-size: 28px; color: #2b6cb0; }
            .kpi span { color: #6b7280; font-size: 14px; }
            section { background: white; padding: 16px; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
            table { width: 100%; border-collapse: collapse; }
            table th, table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid #e5e7eb; }
            table th { background: #f9fafb; font-weight: 600; color: #374151; }
            input[type=text], input[type=number], input[type=email], input[type=password] { padding: 6px 10px; border: 1px solid #d1d5db; border-radius: 4px; }
            button, .btn { padding: 6px 12px; border-radius: 4px; border: 1px solid #2b6cb0; background: #2b6cb0; color: white; cursor: pointer; text-decoration: none; display: inline-block; font-size: 14px; }
            button.secondary, .btn.secondary { background: white; color: #2b6cb0; }
            button.danger, .btn.danger { background: #dc2626; border-color: #dc2626; }
            .grid-render { display: inline-grid; gap: 1px; background: #94a3b8; padding: 1px; }
            .grid-render .cell { width: 18px; height: 18px; background: #c7d2fe; }
            .grid-render .cell.house { background: #f59e0b; }
            .grid-render .cell.office { background: #6366f1; }
            .grid-render .cell.park { background: #10b981; }
            .grid-render .cell.road { background: #6b7280; }
        </style>
    {% endblock %}
</head>
<body class="admin">
<header>
    <nav>
        <a href="{{ path('admin_dashboard') }}">Dashboard</a>
        <a href="{{ path('admin_users_index') }}">Utilisateurs</a>
        <a href="{{ path('admin_scores_index') }}">Scores</a>
        <a href="{{ path('admin_cities_index') }}">Villes</a>
        <span class="spacer"></span>
        {% if app.user %}<span>{{ app.user.pseudonym }}</span>
        <a href="{{ path('admin_logout') }}">Déconnexion</a>{% endif %}
    </nav>
</header>
<main>
    {% for type, msgs in app.flashes %}{% for m in msgs %}<div class="flash flash-{{ type }}">{{ m }}</div>{% endfor %}{% endfor %}
    {% block content %}{% endblock %}
</main>
{% block javascripts %}{% endblock %}
</body>
</html>
