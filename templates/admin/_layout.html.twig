<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — WRA602</title>
    {% block stylesheets %}{{ importmap('app') }}{% endblock %}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --sidebar-w: 210px;
            --black:  #0f0f0f;
            --red:    #c0392b;
            --white:  #ffffff;
            --gray-1: #f5f5f5;
            --gray-2: #e0e0e0;
            --gray-3: #999999;
            --gray-4: #555555;
            --ink:    #111111;
            --mono:   ui-monospace, "SF Mono", monospace;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--white);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
            font-size: 14px;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed;
            top: 0; left: 0; bottom: 0;
            width: var(--sidebar-w);
            background: var(--black);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 20px 16px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .brand-eyebrow {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 4px;
        }
        .brand-name {
            font-size: 18px;
            font-weight: 900;
            color: var(--white);
            letter-spacing: -0.03em;
        }
        .brand-name span { color: var(--red); }

        .sidebar-nav {
            flex: 1;
            padding: 12px 0;
            display: flex;
            flex-direction: column;
        }
        .nav-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 12px 16px 6px;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 16px;
            color: rgba(255,255,255,0.45);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-left: 2px solid transparent;
            transition: color 0.1s, background 0.1s;
        }
        .nav-item:hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.04); }
        .nav-item.active {
            color: var(--white);
            border-left-color: var(--red);
            background: rgba(192,57,43,0.12);
        }
        .nav-icon { width: 15px; height: 15px; flex-shrink: 0; }

        .sidebar-footer {
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 10px;
        }
        .user-avatar {
            width: 28px; height: 28px;
            background: var(--red);
            display: grid;
            place-items: center;
            font-size: 12px;
            font-weight: 700;
            color: var(--white);
            flex-shrink: 0;
        }
        .user-name  { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.8); }
        .user-role  { font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 1px; }
        .logout-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            width: 100%;
            padding: 7px 10px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.4);
            font-size: 12px;
            font-weight: 500;
            text-decoration: none;
            font-family: inherit;
            cursor: pointer;
            transition: border-color 0.1s, color 0.1s;
        }
        .logout-btn:hover { border-color: rgba(192,57,43,0.5); color: rgba(255,100,80,0.9); }

        /* ── Main ── */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: var(--white);
        }

        .topbar {
            position: sticky; top: 0;
            background: var(--white);
            border-bottom: 1px solid var(--gray-2);
            padding: 0 24px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 50;
        }
        .page-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.01em;
        }

        .content { padding: 24px; }

        /* ── Alerts ── */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            margin-bottom: 14px;
            font-size: 13px;
            font-weight: 500;
            border-left: 3px solid;
        }
        .alert-success { background: #f6fdf8; border-color: #27ae60; color: #1a7a40; }
        .alert-error   { background: #fff5f5; border-color: var(--red); color: var(--red); }
        .alert-info    { background: #fffbf5; border-color: #e67e22; color: #b9530a; }

        /* ── Card ── */
        .card {
            background: var(--white);
            border: 1px solid var(--gray-2);
        }
        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid var(--gray-2);
        }
        .card-title { font-size: 12px; font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.06em; }
        .card-body  { padding: 16px; }

        /* ── KPI ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 1px;
            margin-bottom: 24px;
            border: 1px solid var(--gray-2);
            background: var(--gray-2);
        }
        .kpi-card {
            background: var(--white);
            padding: 20px 18px;
            border-top: 3px solid var(--red);
        }
        .kpi-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gray-3); margin-bottom: 8px; }
        .kpi-value { font-size: 30px; font-weight: 900; color: var(--ink); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; font-family: var(--mono); }

        /* ── Table ── */
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        thead th {
            background: var(--gray-1);
            padding: 8px 14px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--gray-4);
            border-bottom: 1px solid var(--gray-2);
            white-space: nowrap;
        }
        tbody tr { border-bottom: 1px solid var(--gray-2); }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--gray-1); }
        td { padding: 10px 14px; color: var(--ink); vertical-align: middle; }
        td.muted { color: var(--gray-4); font-family: var(--mono); font-size: 12px; }

        /* ── Badges ── */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            border: 1px solid;
        }
        .badge-admin  { background: #fff0ee; color: var(--red); border-color: var(--red); }
        .badge-user   { background: var(--gray-1); color: var(--gray-4); border-color: var(--gray-2); }
        .badge-green  { background: #f0fdf4; color: #166534; border-color: #86efac; }
        .badge-gray   { background: var(--gray-1); color: var(--gray-4); border-color: var(--gray-2); }
        .badge-red    { background: #fff0ee; color: var(--red); border-color: var(--red); }
        .badge-blue   { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
        .badge-amber  { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }

        /* ── Buttons ── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid;
            font-family: inherit;
            transition: background 0.1s;
            white-space: nowrap;
        }
        .btn:active { opacity: 0.8; }
        .btn-primary { background: var(--red); color: var(--white); border-color: var(--red); }
        .btn-primary:hover { background: #a93226; border-color: #a93226; }
        .btn-secondary { background: var(--white); color: var(--gray-4); border-color: var(--gray-2); }
        .btn-secondary:hover { background: var(--gray-1); }
        .btn-danger { background: #fff0ee; color: var(--red); border-color: var(--red); }
        .btn-danger:hover { background: #ffe0dc; }
        .btn-sm { padding: 3px 8px; font-size: 11px; }

        /* ── Forms ── */
        .form-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-label { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gray-4); }
        input[type=text], input[type=number], input[type=email], input[type=password] {
            padding: 7px 10px;
            border: 1px solid var(--gray-2);
            font-size: 13px;
            font-family: inherit;
            color: var(--ink);
            background: var(--white);
            outline: none;
            transition: border-color 0.1s;
        }
        input:focus { border-color: var(--ink); }

        /* ── Misc ── */
        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .mb-16 { margin-bottom: 16px; }
        .mb-20 { margin-bottom: 20px; }
        h1 { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 18px; }
        h2 { font-size: 13px; font-weight: 700; margin-bottom: 12px; }
        .empty-state { padding: 32px; text-align: center; color: var(--gray-3); font-size: 13px; }

        .grid-render { display: inline-grid; gap: 1px; background: var(--gray-2); padding: 1px; }
        .cell { width: 13px; height: 13px; background: var(--gray-1); }
        .cell.house      { background: #f59e0b; }
        .cell.office     { background: #6366f1; }
        .cell.park       { background: #22c55e; }
        .cell.road       { background: #94a3b8; }
        .cell.industry   { background: #f97316; }
        .cell.university { background: #a78bfa; }
        .cell.powerplant { background: #ef4444; }
        .cell.port       { background: #14b8a6; }
        .legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
        .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--gray-4); }
        .legend-dot { width: 11px; height: 11px; flex-shrink: 0; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-eyebrow">Back-office</div>
        <div class="brand-name">WRA<span>602</span></div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-label">Navigation</div>

        <a href="{{ path('admin_dashboard') }}" class="nav-item {% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
        </a>

        <a href="{{ path('admin_users_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_users' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Utilisateurs
        </a>

        <a href="{{ path('admin_scores_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_scores' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 21h8"/><path d="M12 17v4"/>
                <path d="M7 4h10v6a5 5 0 0 1-10 0Z"/>
                <path d="M17 4h3v3a3 3 0 0 1-3 3"/>
                <path d="M7 4H4v3a3 3 0 0 0 3 3"/>
            </svg>
            Scores
        </a>

        <a href="{{ path('admin_cities_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_cities' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/>
                <path d="M9 21v-7h6v7"/>
            </svg>
            Villes
        </a>
    </nav>

    {% if app.user %}
    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="user-avatar">{{ app.user.pseudonym|first|upper }}</div>
            <div>
                <div class="user-name">{{ app.user.pseudonym }}</div>
                <div class="user-role">Administrateur</div>
            </div>
        </div>
        <a href="{{ path('admin_logout') }}" class="logout-btn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Deconnexion
        </a>
    </div>
    {% endif %}
</aside>

<div class="main">
    <div class="topbar">
        <span class="page-title">{{ block('title') }}</span>
    </div>
    <main class="content">
        {% for type, msgs in app.flashes %}{% for m in msgs %}
            <div class="alert alert-{{ type }}">{{ m }}</div>
        {% endfor %}{% endfor %}
        {% block content %}{% endblock %}
    </main>
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
