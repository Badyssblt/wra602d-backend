<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — WRA602</title>
    {% block stylesheets %}{{ importmap('app') }}{% endblock %}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --sidebar-w: 220px;
            --forest:   #0c2d22;
            --forest-2: #0f3d2e;
            --forest-3: #164d39;
            --amber:    #d97706;
            --amber-lt: #fbbf24;
            --sand:     #faf8f3;
            --paper:    #f5f2eb;
            --ink:      #1c1917;
            --ink-2:    #44403c;
            --ink-3:    #78716c;
            --border:   #e4dfd5;
            --danger:   #b91c1c;
            --success:  #15803d;
            --radius:   6px;
            --mono:     "JetBrains Mono", "Fira Code", ui-monospace, monospace;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--sand);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
            font-size: 14px;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed;
            top: 0; left: 0; bottom: 0;
            width: var(--sidebar-w);
            background: var(--forest);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 22px 18px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .brand-eyebrow {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(251,191,36,0.6);
            margin-bottom: 4px;
        }
        .brand-name {
            font-size: 20px;
            font-weight: 800;
            color: #faf8f3;
            letter-spacing: -0.03em;
        }
        .brand-name span { color: var(--amber-lt); }

        .sidebar-nav {
            flex: 1;
            padding: 14px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .nav-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            padding: 8px 8px 4px;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 5px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: background 0.1s, color 0.1s;
        }
        .nav-item:hover { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.85); }
        .nav-item.active {
            background: rgba(251,191,36,0.12);
            color: var(--amber-lt);
            border-left: 2px solid var(--amber-lt);
            padding-left: 8px;
        }
        .nav-icon { width: 16px; height: 16px; flex-shrink: 0; }

        .sidebar-footer {
            padding: 14px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 10px;
        }
        .user-avatar {
            width: 30px; height: 30px;
            border-radius: 4px;
            background: var(--amber);
            display: grid;
            place-items: center;
            font-size: 13px;
            font-weight: 700;
            color: var(--forest);
            flex-shrink: 0;
        }
        .user-name  { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.85); }
        .user-role  { font-size: 10px; color: rgba(255,255,255,0.3); letter-spacing: 0.04em; margin-top: 1px; }
        .logout-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            width: 100%;
            padding: 7px 10px;
            border-radius: 4px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.4);
            font-size: 12px;
            font-weight: 500;
            text-decoration: none;
            font-family: inherit;
            cursor: pointer;
            transition: border-color 0.1s, color 0.1s;
        }
        .logout-btn:hover { border-color: rgba(185,28,28,0.5); color: #fca5a5; }

        /* ── Main ── */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            /* graph-paper background */
            background-color: var(--sand);
            background-image:
                linear-gradient(var(--border) 1px, transparent 1px),
                linear-gradient(90deg, var(--border) 1px, transparent 1px);
            background-size: 28px 28px;
        }

        .topbar {
            position: sticky; top: 0;
            background: rgba(250,248,243,0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 0 28px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 50;
        }
        .page-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.01em;
        }

        .content { padding: 24px 28px; }

        /* ── Alerts ── */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: var(--radius);
            margin-bottom: 14px;
            font-size: 13px;
            font-weight: 500;
            border-left: 3px solid;
        }
        .alert-success { background: #f0fdf4; border-color: #22c55e; color: var(--success); }
        .alert-error   { background: #fef2f2; border-color: #ef4444; color: var(--danger); }
        .alert-info    { background: #fffbeb; border-color: var(--amber); color: var(--amber); }

        /* ── Card ── */
        .card {
            background: #fffef9;
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }
        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
        }
        .card-title { font-size: 13px; font-weight: 700; color: var(--ink); letter-spacing: 0.01em; }
        .card-body  { padding: 18px; }

        /* ── KPI ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }
        .kpi-card {
            background: #fffef9;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 3px; height: 100%;
            background: var(--amber);
        }
        .kpi-icon { font-size: 22px; margin-bottom: 8px; }
        .kpi-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 4px; }
        .kpi-value { font-size: 28px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; font-family: var(--mono); }

        /* ── Table ── */
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        thead th {
            background: var(--paper);
            padding: 9px 14px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--ink-3);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        tbody tr { border-bottom: 1px solid var(--border); transition: background 0.08s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--paper); }
        td { padding: 10px 14px; color: var(--ink); vertical-align: middle; }
        td.muted { color: var(--ink-3); font-family: var(--mono); font-size: 12px; }

        /* ── Badges ── */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 7px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .badge-admin  { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
        .badge-user   { background: var(--paper); color: var(--ink-3); border: 1px solid var(--border); }
        .badge-green  { background: #f0fdf4; color: var(--success); border: 1px solid #86efac; }
        .badge-gray   { background: var(--paper); color: var(--ink-3); border: 1px solid var(--border); }

        /* ── Buttons ── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 12px;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid transparent;
            font-family: inherit;
            transition: background 0.1s, border-color 0.1s;
            white-space: nowrap;
        }
        .btn:active { opacity: 0.85; }
        .btn-primary { background: var(--amber); color: var(--forest); border-color: var(--amber); }
        .btn-primary:hover { background: var(--amber-lt); border-color: var(--amber-lt); }
        .btn-secondary { background: #fffef9; color: var(--ink-2); border-color: var(--border); }
        .btn-secondary:hover { background: var(--paper); }
        .btn-danger { background: #fef2f2; color: var(--danger); border-color: #fca5a5; }
        .btn-danger:hover { background: #fee2e2; }
        .btn-sm { padding: 4px 9px; font-size: 11px; }

        /* ── Forms ── */
        .form-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
        input[type=text], input[type=number], input[type=email], input[type=password] {
            padding: 7px 11px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-size: 13px;
            font-family: inherit;
            color: var(--ink);
            background: #fffef9;
            outline: none;
            transition: border-color 0.1s, box-shadow 0.1s;
        }
        input:focus { border-color: var(--amber); box-shadow: 0 0 0 3px rgba(217,119,6,0.12); }

        /* ── Misc ── */
        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .mb-16 { margin-bottom: 16px; }
        .mb-20 { margin-bottom: 20px; }
        h1 { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 18px; }
        h2 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
        .empty-state { padding: 32px; text-align: center; color: var(--ink-3); font-size: 13px; font-style: italic; }

        .grid-render { display: inline-grid; gap: 1px; background: var(--border); padding: 1px; border-radius: 3px; }
        .cell { width: 13px; height: 13px; background: var(--paper); }
        .cell.house      { background: #f59e0b; }
        .cell.office     { background: #6366f1; }
        .cell.park       { background: #22c55e; }
        .cell.road       { background: #94a3b8; }
        .cell.industry   { background: #f97316; }
        .cell.university { background: #a78bfa; }
        .cell.powerplant { background: #ef4444; }
        .cell.port       { background: #14b8a6; }
        .legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
        .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--ink-3); }
        .legend-dot { width: 11px; height: 11px; border-radius: 2px; flex-shrink: 0; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-eyebrow">Back-office</div>
        <div class="brand-name">WRA<span>602</span></div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-label">Menu</div>

        <a href="{{ path('admin_dashboard') }}" class="nav-item {% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
            Dashboard
        </a>

        <a href="{{ path('admin_users_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_users' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Utilisateurs
        </a>

        <a href="{{ path('admin_scores_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_scores' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 21h8"/><path d="M12 17v4"/>
                <path d="M7 4h10v6a5 5 0 0 1-10 0Z"/>
                <path d="M17 4h3v3a3 3 0 0 1-3 3"/>
                <path d="M7 4H4v3a3 3 0 0 0 3 3"/>
            </svg>
            Scores
        </a>

        <a href="{{ path('admin_cities_index') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_cities' %}active{% endif %}">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/>
                <path d="M9 21v-7h6v7"/>
            </svg>
            Villes
        </a>
    </nav>

    {% if app.user %}
    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="user-avatar">{{ app.user.pseudonym|first|upper }}</div>
            <div>
                <div class="user-name">{{ app.user.pseudonym }}</div>
                <div class="user-role">Administrateur</div>
            </div>
        </div>
        <a href="{{ path('admin_logout') }}" class="logout-btn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Déconnexion
        </a>
    </div>
    {% endif %}
</aside>

<div class="main">
    <div class="topbar">
        <span class="page-title">{% block title %}Admin{% endblock %}</span>
    </div>
    <main class="content">
        {% for type, msgs in app.flashes %}{% for m in msgs %}
            <div class="alert alert-{{ type }}">{{ m }}</div>
        {% endfor %}{% endfor %}
        {% block content %}{% endblock %}
    </main>
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
