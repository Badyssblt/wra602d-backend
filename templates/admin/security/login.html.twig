<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion — WRA602 Admin</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #0f172a;
            overflow: hidden;
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 80%, rgba(59,130,246,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 60% 80% at 80% 20%, rgba(99,102,241,0.10) 0%, transparent 60%);
            pointer-events: none;
        }

        .card {
            position: relative;
            width: min(400px, 92vw);
            background: rgba(15,23,42,0.80);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 36px 32px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 28px;
        }
        .brand-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            display: grid;
            place-items: center;
            font-size: 22px;
        }
        .brand-text .name { font-size: 18px; font-weight: 700; color: #f8fafc; }
        .brand-text .sub  { font-size: 11px; color: #475569; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 1px; }

        h1 { font-size: 22px; font-weight: 700; color: #f8fafc; margin-bottom: 6px; }
        .subtitle { font-size: 13px; color: #64748b; margin-bottom: 26px; }

        .err {
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.3);
            color: #fca5a5;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            margin-bottom: 18px;
        }

        label {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }
        .label-text {
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
            letter-spacing: 0.04em;
        }
        input {
            width: 100%;
            padding: 11px 14px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 9px;
            color: #f8fafc;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        }
        input::placeholder { color: #334155; }
        input:focus {
            border-color: rgba(59,130,246,0.6);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
            background: rgba(255,255,255,0.07);
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 8px;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border: none;
            border-radius: 9px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: opacity 0.15s, transform 0.1s;
            box-shadow: 0 4px 14px rgba(59,130,246,0.35);
        }
        button:hover { opacity: 0.92; }
        button:active { transform: scale(0.98); }
    </style>
</head>
<body>
<div class="card">
    <div class="brand">
        <div class="brand-icon">🏙️</div>
        <div class="brand-text">
            <div class="name">WRA602</div>
            <div class="sub">Back-office</div>
        </div>
    </div>

    <h1>Connexion</h1>
    <p class="subtitle">Accès réservé aux administrateurs</p>

    {% if error %}<div class="err">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}

    <form method="post">
        <label>
            <span class="label-text">Adresse email</span>
            <input type="email" name="email" value="{{ last_username }}" required autofocus autocomplete="email" placeholder="admin@exemple.com">
        </label>
        <label>
            <span class="label-text">Mot de passe</span>
            <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
        </label>
        <button type="submit">Se connecter →</button>
    </form>
</div>
</body>
</html>
