<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion — WRA602 Admin</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            min-height: 100vh;
            background: #fff;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* Left panel */
        .left {
            background: #0f0f0f;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 48px 40px;
        }
        .left-brand {}
        .eyebrow {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-bottom: 10px;
        }
        .left-brand h1 {
            font-size: 48px;
            font-weight: 900;
            letter-spacing: -0.05em;
            color: #fff;
            line-height: 1;
        }
        .left-brand h1 span { color: #c0392b; }
        .left-desc {
            margin-top: 16px;
            font-size: 14px;
            color: rgba(255,255,255,0.35);
            line-height: 1.6;
            max-width: 280px;
        }
        .left-stats {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .stat-line {
            display: flex;
            align-items: baseline;
            gap: 10px;
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 14px;
        }
        .stat-line:first-child { border-top: none; }
        .stat-num {
            font-size: 28px;
            font-weight: 900;
            color: #fff;
            letter-spacing: -0.04em;
            font-variant-numeric: tabular-nums;
            font-family: ui-monospace, monospace;
        }
        .stat-unit {
            font-size: 12px;
            color: rgba(255,255,255,0.35);
            font-weight: 500;
        }

        /* Right panel */
        .right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
            background: #fafafa;
        }
        .form-wrap {
            width: min(340px, 100%);
        }
        .form-head {
            margin-bottom: 28px;
        }
        .form-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #111;
        }
        .form-sub {
            font-size: 13px;
            color: #888;
            margin-top: 4px;
        }
        .err {
            background: #fff0ee;
            border: 1px solid #c0392b;
            border-left: 3px solid #c0392b;
            color: #c0392b;
            padding: 9px 12px;
            font-size: 13px;
            margin-bottom: 18px;
        }
        label {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 14px;
        }
        .label-text {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #888;
        }
        input {
            width: 100%;
            padding: 10px 12px;
            background: #fff;
            border: 1px solid #e0e0e0;
            color: #111;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.1s;
        }
        input::placeholder { color: #ccc; }
        input:focus { border-color: #111; }
        button {
            width: 100%;
            padding: 12px;
            margin-top: 4px;
            background: #c0392b;
            border: none;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            letter-spacing: 0.01em;
            transition: background 0.1s;
        }
        button:hover { background: #a93226; }
        button:active { opacity: 0.85; }

        @media (max-width: 640px) {
            body { grid-template-columns: 1fr; }
            .left { display: none; }
        }
    </style>
</head>
<body>

<div class="left">
    <div class="left-brand">
        <div class="eyebrow">Administration</div>
        <h1>WRA<span>602</span></h1>
        <p class="left-desc">Panneau de gestion des utilisateurs, scores et villes.</p>
    </div>

    <div class="left-stats">
        <div class="stat-line">
            <span class="stat-num">100%</span>
            <span class="stat-unit">acces controle</span>
        </div>
        <div class="stat-line">
            <span class="stat-num">API</span>
            <span class="stat-unit">temps reel</span>
        </div>
        <div class="stat-line">
            <span class="stat-num">WRA</span>
            <span class="stat-unit">back-office v1</span>
        </div>
    </div>
</div>

<div class="right">
    <div class="form-wrap">
        <div class="form-head">
            <div class="form-title">Connexion</div>
            <div class="form-sub">Acces reserve aux administrateurs</div>
        </div>

        {% if error %}<div class="err">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}

        <form method="post">
            <label>
                <span class="label-text">Email</span>
                <input type="email" name="email" value="{{ last_username }}" required autofocus autocomplete="email" placeholder="admin@exemple.com">
            </label>
            <label>
                <span class="label-text">Mot de passe</span>
                <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
            </label>
            <button type="submit">Acceder au back-office</button>
        </form>
    </div>
</div>

</body>
</html>
