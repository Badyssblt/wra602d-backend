{% extends 'admin/_layout.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-label">Utilisateurs</div>
        <div class="kpi-value">{{ usersCount }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Scores soumis</div>
        <div class="kpi-value">{{ scoresCount }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Villes sauvegardees</div>
        <div class="kpi-value">{{ citiesCount }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Score moyen</div>
        <div class="kpi-value">{{ avgScore|number_format(0, '.', ' ') }}</div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-bottom:1px;background:var(--gray-2);">

    <div class="card" style="border:none;">
        <div class="card-header">
            <div class="card-title">Activite — 7 derniers jours</div>
        </div>
        <div class="card-body">
            <canvas id="activityChart"
                    data-controller="chart"
                    data-chart-type-value="line"
                    data-chart-data-value="{{ {labels: last7days|map(d => d.day), datasets: [{label: 'Scores soumis', data: last7days|map(d => d.count), borderColor: '#c0392b', backgroundColor: 'rgba(192,57,43,0.06)', fill: true, tension: 0.3, pointBackgroundColor: '#c0392b'}]}|json_encode|e('html_attr') }}"
                    style="width:100%;height:200px;"></canvas>
        </div>
    </div>

    <div class="card" style="border:none;">
        <div class="card-header">
            <div class="card-title">Inscriptions recentes</div>
            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary btn-sm">Voir tout</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Joueur</th><th>Email</th><th>Date</th></tr></thead>
                <tbody>
                {% for u in recentUsers %}
                <tr>
                    <td style="font-weight:600;">{{ u.pseudonym }}</td>
                    <td class="muted">{{ u.email }}</td>
                    <td class="muted">{{ u.createdAt|date('d/m/Y') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="3" class="empty-state">Aucun utilisateur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="card" style="margin-top:0;border-top:none;">
    <div class="card-header">
        <div class="card-title">Top 10 scores</div>
        <a href="{{ path('admin_scores_index') }}" class="btn btn-secondary btn-sm">Voir tout</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>#</th><th>Joueur</th><th>Score</th><th>Population</th><th>Date</th></tr></thead>
            <tbody>
            {% for s in topScores %}
            <tr>
                <td>
                    <span style="font-family:var(--mono);font-weight:700;font-size:12px;color:{% if loop.index <= 3 %}var(--red){% else %}var(--gray-3){% endif %};">{{ loop.index }}</span>
                </td>
                <td style="font-weight:600;">{{ s.user.pseudonym }}</td>
                <td><span style="font-family:var(--mono);font-weight:700;">{{ s.score|number_format(0, '.', ' ') }}</span></td>
                <td class="muted">{{ s.population|number_format(0, '.', ' ') }} hab.</td>
                <td class="muted">{{ s.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="empty-state">Aucun score.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
