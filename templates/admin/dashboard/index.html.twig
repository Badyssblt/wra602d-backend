{% extends 'admin/_layout.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon blue">👥</div>
        <div class="kpi-body">
            <div class="kpi-label">Utilisateurs</div>
            <div class="kpi-value">{{ usersCount }}</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon purple">🏆</div>
        <div class="kpi-body">
            <div class="kpi-label">Scores soumis</div>
            <div class="kpi-value">{{ scoresCount }}</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green">🏙️</div>
        <div class="kpi-body">
            <div class="kpi-label">Villes sauvegardées</div>
            <div class="kpi-value">{{ citiesCount }}</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon amber">📊</div>
        <div class="kpi-body">
            <div class="kpi-label">Score moyen</div>
            <div class="kpi-value">{{ avgScore|number_format(0, '.', ' ') }}</div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <div class="card">
        <div class="card-header">
            <div class="card-title">📈 Activité — 7 derniers jours</div>
        </div>
        <div class="card-body">
            <canvas id="activityChart"
                    data-controller="chart"
                    data-chart-type-value="line"
                    data-chart-data-value="{{ {labels: last7days|map(d => d.day), datasets: [{label: 'Scores soumis', data: last7days|map(d => d.count), borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.08)', fill: true, tension: 0.4, pointBackgroundColor: '#3b82f6'}]}|json_encode|e('html_attr') }}"
                    style="width:100%;height:200px;"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title">🕐 Inscriptions récentes</div>
            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary btn-sm">Voir tout</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Joueur</th><th>Email</th><th>Date</th></tr></thead>
                <tbody>
                {% for u in recentUsers %}
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#1d4ed8);display:grid;place-items:center;font-size:12px;font-weight:700;color:white;flex-shrink:0;">
                                {{ u.pseudonym|first|upper }}
                            </div>
                            <span style="font-weight:500;">{{ u.pseudonym }}</span>
                        </div>
                    </td>
                    <td class="muted">{{ u.email }}</td>
                    <td class="muted">{{ u.createdAt|date('d/m/Y') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="3" class="empty-state">Aucun utilisateur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="card">
    <div class="card-header">
        <div class="card-title">🏆 Top 10 scores</div>
        <a href="{{ path('admin_scores_index') }}" class="btn btn-secondary btn-sm">Voir tout</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>#</th><th>Joueur</th><th>Score</th><th>Population</th><th>Date</th></tr></thead>
            <tbody>
            {% for s in topScores %}
            <tr>
                <td>
                    {% if loop.index == 1 %}<span class="badge badge-amber">🥇 1</span>
                    {% elseif loop.index == 2 %}<span class="badge badge-gray">🥈 2</span>
                    {% elseif loop.index == 3 %}<span class="badge badge-gray">🥉 3</span>
                    {% else %}<span style="color:var(--text-muted);font-weight:600;">{{ loop.index }}</span>
                    {% endif %}
                </td>
                <td style="font-weight:500;">{{ s.user.pseudonym }}</td>
                <td><strong style="color:#1d4ed8;">{{ s.score|number_format(0, '.', ' ') }}</strong></td>
                <td class="muted">{{ s.population|number_format(0, '.', ' ') }} hab.</td>
                <td class="muted">{{ s.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="empty-state">Aucun score.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
