{% extends 'admin/_layout.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}
    <h1>Dashboard</h1>

    <div class="kpis">
        <div class="kpi"><strong>{{ usersCount }}</strong><span>Utilisateurs</span></div>
        <div class="kpi"><strong>{{ scoresCount }}</strong><span>Scores</span></div>
        <div class="kpi"><strong>{{ citiesCount }}</strong><span>Villes sauvegardées</span></div>
        <div class="kpi"><strong>{{ avgScore|number_format(0, '.', ' ') }}</strong><span>Score moyen</span></div>
    </div>

    <section>
        <h2>Activité 7 derniers jours</h2>
        <canvas data-controller="chart"
                data-chart-type-value="line"
                data-chart-data-value="{{ {labels: last7days|map(d => d.day), datasets: [{label: 'Scores soumis', data: last7days|map(d => d.count), borderColor: '#2b6cb0'}]}|json_encode|e('html_attr') }}"
                style="max-width: 100%; height: 240px;"></canvas>
    </section>

    <section>
        <h2>Top 10 scores</h2>
        <table>
            <thead><tr><th>#</th><th>Joueur</th><th>Score</th><th>Population</th><th>Date</th></tr></thead>
            <tbody>
            {% for s in topScores %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ s.user.pseudonym }}</td>
                    <td>{{ s.score }}</td>
                    <td>{{ s.population }}</td>
                    <td>{{ s.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5"><em>Aucun score pour le moment.</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>

    <section>
        <h2>Inscriptions récentes</h2>
        <table>
            <thead><tr><th>Pseudonyme</th><th>Email</th><th>Inscription</th><th></th></tr></thead>
            <tbody>
            {% for u in recentUsers %}
                <tr>
                    <td>{{ u.pseudonym }}</td>
                    <td>{{ u.email }}</td>
                    <td>{{ u.createdAt|date('d/m/Y H:i') }}</td>
                    <td><a class="btn secondary" href="{{ path('admin_users_show', {uid: u.uid}) }}">Voir</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
