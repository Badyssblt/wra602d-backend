{% extends 'admin/_layout.html.twig' %}
{% block title %}{{ user.pseudonym }}{% endblock %}
{% block content %}

<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
    <a href="{{ path('admin_users_index') }}" style="color:var(--text-muted);text-decoration:none;font-size:13px;">← Utilisateurs</a>
</div>

<div style="display:grid;grid-template-columns:320px 1fr;gap:20px;margin-bottom:20px;">

    <div class="card">
        <div class="card-body" style="text-align:center;padding:28px 20px;">
            <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#1d4ed8);display:grid;place-items:center;font-size:30px;font-weight:700;color:white;margin:0 auto 16px;">
                {{ user.pseudonym|first|upper }}
            </div>
            <div style="font-size:20px;font-weight:700;margin-bottom:4px;">{{ user.pseudonym }}</div>
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:16px;">{{ user.email }}</div>
            <div style="display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-bottom:20px;">
                {% for role in user.roles %}
                    {% if role == 'ROLE_ADMIN' %}<span class="badge badge-red">Admin</span>
                    {% elseif role == 'ROLE_USER' %}<span class="badge badge-blue">User</span>
                    {% else %}<span class="badge badge-gray">{{ role }}</span>
                    {% endif %}
                {% endfor %}
            </div>
            <div style="font-size:12px;color:var(--text-muted);background:#f8fafc;border-radius:6px;padding:8px 10px;text-align:left;margin-bottom:16px;word-break:break-all;">
                <span style="font-weight:600;">UID:</span> {{ user.uid }}
            </div>
            <div style="font-size:13px;color:var(--text-muted);margin-bottom:20px;">
                Inscrit le {{ user.createdAt|date('d/m/Y à H:i') }}
            </div>

            <div style="display:flex;flex-direction:column;gap:8px;">
                <form method="post" action="{{ path('admin_users_promote', {uid: user.uid}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.uid) }}">
                    <button type="submit" class="btn btn-secondary" style="width:100%;justify-content:center;">
                        {% if 'ROLE_ADMIN' in user.roles %}
                        🔽 Retirer les droits admin
                        {% else %}
                        🔼 Promouvoir admin
                        {% endif %}
                    </button>
                </form>
                <form method="post" action="{{ path('admin_users_delete', {uid: user.uid}) }}" onsubmit="return confirm('Supprimer {{ user.pseudonym }} ? Cette action est irréversible.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.uid) }}">
                    <button type="submit" class="btn btn-danger" style="width:100%;justify-content:center;">🗑️ Supprimer l'utilisateur</button>
                </form>
            </div>
        </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px;">

        <div class="card">
            <div class="card-header">
                <div class="card-title">🏆 Scores ({{ user.scores|length }})</div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Score</th><th>Population</th><th>Date</th></tr></thead>
                    <tbody>
                    {% for s in user.scores %}
                    <tr>
                        <td><strong style="color:#1d4ed8;">{{ s.score|number_format(0,'.', ' ') }}</strong></td>
                        <td class="muted">{{ s.population|number_format(0,'.',' ') }} hab.</td>
                        <td class="muted">{{ s.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="3" class="empty-state">Aucun score.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">🏙️ Villes ({{ user.cities|length }})</div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Nom</th><th>Trésor</th><th>Bâtiments</th><th>Mise à jour</th><th></th></tr></thead>
                    <tbody>
                    {% for c in user.cities %}
                    <tr>
                        <td style="font-weight:500;">{{ c.name }}</td>
                        <td class="muted">{{ c.money|number_format(0,'.',' ') }} €</td>
                        <td class="muted">{{ c.buildings|length }}</td>
                        <td class="muted">{{ c.updatedAt|date('d/m/Y H:i') }}</td>
                        <td><a class="btn btn-secondary btn-sm" href="{{ path('admin_cities_show', {uid: c.uid}) }}">Voir →</a></td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="empty-state">Aucune ville.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

{% endblock %}
