{% extends 'admin/_layout.html.twig' %}
{% block title %}{{ user.pseudonym }}{% endblock %}
{% block content %}

<div style="margin-bottom:20px;">
    <a href="{{ path('admin_users_index') }}" style="color:var(--gray-4);text-decoration:none;font-size:12px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;">← Utilisateurs</a>
</div>

<div style="display:grid;grid-template-columns:280px 1fr;gap:1px;background:var(--gray-2);">

    <div class="card" style="border:none;align-self:start;">
        <div class="card-header">
            <div class="card-title">Profil</div>
        </div>
        <div class="card-body">
            <div style="display:flex;flex-direction:column;gap:14px;">
                <div>
                    <div style="width:52px;height:52px;background:var(--ink);display:grid;place-items:center;font-size:22px;font-weight:700;color:var(--white);font-family:var(--mono);">
                        {{ user.pseudonym|first|upper }}
                    </div>
                    <div style="font-size:18px;font-weight:800;margin-top:10px;letter-spacing:-0.02em;">{{ user.pseudonym }}</div>
                    <div style="font-size:12px;color:var(--gray-4);margin-top:2px;font-family:var(--mono);">{{ user.email }}</div>
                </div>

                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                    {% for role in user.roles %}
                        {% if role == 'ROLE_ADMIN' %}<span class="badge badge-red">Admin</span>
                        {% elseif role == 'ROLE_USER' %}<span class="badge badge-user">User</span>
                        {% else %}<span class="badge badge-gray">{{ role }}</span>
                        {% endif %}
                    {% endfor %}
                </div>

                <div style="font-size:11px;color:var(--gray-4);font-family:var(--mono);word-break:break-all;padding:8px;background:var(--gray-1);border:1px solid var(--gray-2);">
                    {{ user.uid }}
                </div>

                <div style="font-size:12px;color:var(--gray-3);">
                    Inscrit le {{ user.createdAt|date('d/m/Y a H:i') }}
                </div>

                <div style="display:flex;flex-direction:column;gap:6px;padding-top:4px;border-top:1px solid var(--gray-2);">
                    <form method="post" action="{{ path('admin_users_promote', {uid: user.uid}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.uid) }}">
                        <button type="submit" class="btn btn-secondary" style="width:100%;justify-content:center;">
                            {% if 'ROLE_ADMIN' in user.roles %}Retirer admin{% else %}Promouvoir admin{% endif %}
                        </button>
                    </form>
                    <form method="post" action="{{ path('admin_users_delete', {uid: user.uid}) }}" onsubmit="return confirm('Supprimer {{ user.pseudonym }} ? Cette action est irreversible.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.uid) }}">
                        <button type="submit" class="btn btn-danger" style="width:100%;justify-content:center;">Supprimer l'utilisateur</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:1px;background:var(--gray-2);">

        <div class="card" style="border:none;">
            <div class="card-header">
                <div class="card-title">Scores ({{ user.scores|length }})</div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Score</th><th>Population</th><th>Date</th></tr></thead>
                    <tbody>
                    {% for s in user.scores %}
                    <tr>
                        <td><span style="font-family:var(--mono);font-weight:700;">{{ s.score|number_format(0,'.', ' ') }}</span></td>
                        <td class="muted">{{ s.population|number_format(0,'.',' ') }} hab.</td>
                        <td class="muted">{{ s.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="3" class="empty-state">Aucun score.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card" style="border:none;">
            <div class="card-header">
                <div class="card-title">Villes ({{ user.cities|length }})</div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Nom</th><th>Tresor</th><th>Batiments</th><th>Mise a jour</th><th></th></tr></thead>
                    <tbody>
                    {% for c in user.cities %}
                    <tr>
                        <td style="font-weight:600;">{{ c.name }}</td>
                        <td class="muted">{{ c.money|number_format(0,'.',' ') }} €</td>
                        <td class="muted">{{ c.buildings|length }}</td>
                        <td class="muted">{{ c.updatedAt|date('d/m/Y H:i') }}</td>
                        <td><a class="btn btn-secondary btn-sm" href="{{ path('admin_cities_show', {uid: c.uid}) }}">Voir →</a></td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="empty-state">Aucune ville.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

{% endblock %}
